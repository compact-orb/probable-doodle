# Server Core Settings
MAIL_MCP_TRANSPORT=http
MAIL_MCP_HTTP_HOST={{ mail_mcp_http_host }}
MAIL_MCP_HTTP_PORT={{ mail_mcp_http_port }}
MAIL_MCP_HTTP_PATH={{ mail_mcp_http_path }}

# Safety Gates
MAIL_IMAP_WRITE_ENABLED={{ mail_imap_write_enabled | string | lower }}
MAIL_SMTP_WRITE_ENABLED={{ mail_smtp_write_enabled | string | lower }}
MAIL_DRAFTS_ENABLED={{ mail_drafts_enabled | string | lower }}

MAIL_ATTACHMENT_UPLOAD_DIR={{ mail_attachment_upload_dir }}
MAIL_OAUTH2_TOKEN_STORE={{ mail_oauth2_token_store }}

{% if secrets.gmail_personal is defined and
      secrets.gmail_personal.user | default('') %}
# --- 1. Personal Gmail ---
MAIL_IMAP_GMAIL_PERSONAL_HOST={{ mail_accounts.gmail_personal.imap_host }}
MAIL_IMAP_GMAIL_PERSONAL_PORT={{ mail_accounts.gmail_personal.imap_port }}
MAIL_IMAP_GMAIL_PERSONAL_USER={{ secrets.gmail_personal.user }}
MAIL_IMAP_GMAIL_PERSONAL_SECURE=true
MAIL_SMTP_GMAIL_PERSONAL_HOST={{ mail_accounts.gmail_personal.smtp_host }}
MAIL_SMTP_GMAIL_PERSONAL_PORT={{ mail_accounts.gmail_personal.smtp_port }}
MAIL_SMTP_GMAIL_PERSONAL_USER={{ secrets.gmail_personal.user }}
MAIL_SMTP_GMAIL_PERSONAL_SECURE={{ mail_accounts.gmail_personal.smtp_secure }}
MAIL_OAUTH2_GMAIL_PERSONAL_PROVIDER={{
  mail_accounts.gmail_personal.provider }}
MAIL_OAUTH2_GMAIL_PERSONAL_CLIENT_ID={{
  secrets.gmail_personal.client_id }}
MAIL_OAUTH2_GMAIL_PERSONAL_CLIENT_SECRET={{
  secrets.gmail_personal.client_secret }}
MAIL_OAUTH2_GMAIL_PERSONAL_REFRESH_TOKEN={{
  secrets.gmail_personal.refresh_token }}
{% endif %}

{% if secrets.outlook_personal is defined and
      secrets.outlook_personal.user | default('') %}
# --- 2. Personal Outlook ---
MAIL_IMAP_OUTLOOK_PERSONAL_HOST={{ mail_accounts.outlook_personal.imap_host }}
MAIL_IMAP_OUTLOOK_PERSONAL_PORT={{ mail_accounts.outlook_personal.imap_port }}
MAIL_IMAP_OUTLOOK_PERSONAL_USER={{ secrets.outlook_personal.user }}
MAIL_IMAP_OUTLOOK_PERSONAL_SECURE=true
MAIL_OAUTH2_OUTLOOK_PERSONAL_PROVIDER={{
  mail_accounts.outlook_personal.provider }}
MAIL_OAUTH2_OUTLOOK_PERSONAL_CLIENT_ID={{
  secrets.outlook_personal.client_id }}
MAIL_OAUTH2_OUTLOOK_PERSONAL_CLIENT_SECRET={{
  secrets.outlook_personal.client_secret | default('none') }}
MAIL_OAUTH2_OUTLOOK_PERSONAL_REFRESH_TOKEN={{
  secrets.outlook_personal.refresh_token }}
{% endif %}

{% if secrets.outlook_work is defined and
      secrets.outlook_work.user | default('') %}
# --- 3. Business Outlook (Work) ---
MAIL_IMAP_OUTLOOK_WORK_HOST={{ mail_accounts.outlook_work.imap_host }}
MAIL_IMAP_OUTLOOK_WORK_PORT={{ mail_accounts.outlook_work.imap_port }}
MAIL_IMAP_OUTLOOK_WORK_USER={{ secrets.outlook_work.user }}
MAIL_IMAP_OUTLOOK_WORK_SECURE=true
MAIL_SMTP_OUTLOOK_WORK_HOST={{ mail_accounts.outlook_work.smtp_host }}
MAIL_SMTP_OUTLOOK_WORK_PORT={{ mail_accounts.outlook_work.smtp_port }}
MAIL_SMTP_OUTLOOK_WORK_USER={{ secrets.outlook_work.user }}
MAIL_SMTP_OUTLOOK_WORK_SECURE={{ mail_accounts.outlook_work.smtp_secure }}
MAIL_OAUTH2_OUTLOOK_WORK_PROVIDER={{ mail_accounts.outlook_work.provider }}
MAIL_OAUTH2_OUTLOOK_WORK_CLIENT_ID={{ secrets.outlook_work.client_id }}
MAIL_OAUTH2_OUTLOOK_WORK_CLIENT_SECRET={{
  secrets.outlook_work.client_secret }}
MAIL_OAUTH2_OUTLOOK_WORK_REFRESH_TOKEN={{
  secrets.outlook_work.refresh_token }}
{% endif %}

{% if secrets.gmail_school is defined and
      secrets.gmail_school.user | default('') %}
# --- 4. Business Gmail (School) ---
MAIL_IMAP_GMAIL_SCHOOL_HOST={{ mail_accounts.gmail_school.imap_host }}
MAIL_IMAP_GMAIL_SCHOOL_PORT={{ mail_accounts.gmail_school.imap_port }}
MAIL_IMAP_GMAIL_SCHOOL_USER={{ secrets.gmail_school.user }}
MAIL_IMAP_GMAIL_SCHOOL_SECURE=true
MAIL_SMTP_GMAIL_SCHOOL_HOST={{ mail_accounts.gmail_school.smtp_host }}
MAIL_SMTP_GMAIL_SCHOOL_PORT={{ mail_accounts.gmail_school.smtp_port }}
MAIL_SMTP_GMAIL_SCHOOL_USER={{ secrets.gmail_school.user }}
MAIL_SMTP_GMAIL_SCHOOL_SECURE={{ mail_accounts.gmail_school.smtp_secure }}
MAIL_OAUTH2_GMAIL_SCHOOL_PROVIDER={{ mail_accounts.gmail_school.provider }}
MAIL_OAUTH2_GMAIL_SCHOOL_CLIENT_ID={{ secrets.gmail_school.client_id }}
MAIL_OAUTH2_GMAIL_SCHOOL_CLIENT_SECRET={{
  secrets.gmail_school.client_secret }}
MAIL_OAUTH2_GMAIL_SCHOOL_REFRESH_TOKEN={{
  secrets.gmail_school.refresh_token }}
{% endif %}
